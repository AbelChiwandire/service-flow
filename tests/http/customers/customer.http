#       "email": "test@example.com",
#       "phone": "555-1234",
#       "address": "123 Main St",
#       "createdAt": "2026-09-26T13:09:05.102Z",
#       "updatedAt": "2026-09-26T13:09:05.102Z",
#       "isDeleted": false,
#       "deletedAt": null
#     }
#   ]
# }

### Get by valid id — expect 200, customer returned
GET {{baseUrl}}/api/customers/{{createCustomer.response.body.$.data.id}}

# --- Actual response ---
# Status: 200 OK
# Body: {
#   "data": {
#     "id": "5d22815f-08ce-402f-9d77-eaf6e0383b47",
#     "userId": "00000000-0000-0000-0000-000000000001",
#     "name": "Test Customer",
#     "email": "test@example.com",
#     "phone": "555-1234",
#     "address": "123 Main St",
