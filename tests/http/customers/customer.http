@baseUrl = http://localhost:3000

### =========================================
### CREATE
### =========================================

### Create with valid data — expect 201
# @name createCustomer
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "name": "Test Customer",
  "email": "test@example.com",
  "phone": "555-1234",
  "address": "123 Main St"
}

# --- Actual response ---
# Status: 201 Created
# Body: {
#   "data": {
#     "id": "5d22815f-08ce-402f-9d77-eaf6e0383b47",
#     "userId": "00000000-0000-0000-0000-000000000001",
#     "name": "Test Customer",
#     "email": "test@example.com",
#     "phone": "555-1234",
#     "address": "123 Main St",
#     "createdAt": "2026-09-26T13:09:05.102Z",
#     "updatedAt": "2026-09-26T13:09:05.102Z",
#     "isDeleted": false,
#     "deletedAt": null
#   }
# }

### Create with invalid email — expect 400, field-level errors
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "name": "Bad Email Customer",
  "email": "not-an-email",
  "phone": "555-1234",
  "address": "123 Main St"
}

# --- Actual response ---
# Status: 400 Bad Request
# Body: {
#   "error": "Missing or invalid fields.",
#   "details": {
#     "email": ["Invalid email address."]
#   }
# }

### Create with missing fields — expect 400, field-level errors
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "name": "Incomplete Customer"
}

# --- Actual response ---
# Status: 400 Bad Request
# Body: {
#   "error": "Missing or invalid fields.",
#   "details": {
#     "email": [
#       "Invalid input: expected string, received undefined"
#     ],
#     "phone": [
#       "Invalid input: expected string, received undefined"
#     ],
#     "address": [
#       "Invalid input: expected string, received undefined"
#     ]
#   }
# }

### =========================================
### READ
### =========================================

### List customers — expect 200, only current user's customers
GET {{baseUrl}}/api/customers

# --- Actual response ---
# Status: 200 OK
# Body: {
#   "data": [
#     {
#       "id": "5d22815f-08ce-402f-9d77-eaf6e0383b47",
