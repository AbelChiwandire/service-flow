@baseUrl = http://localhost:3000

### Create a customer
# @name createCustomer
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "name": "Test Customer",
  "email": "test@example.com",
  "phone": "555-1234",
  "address": "123 Main St"
}

### Get the customer just created
GET {{baseUrl}}/api/customers/{{createCustomer.response.body.$.data.id}}

### Update it (partial)
PATCH {{baseUrl}}/api/customers/{{createCustomer.response.body.$.data.id}}
Content-Type: application/json

{
  "phone": "555-9999"
}

### Delete it
DELETE {{baseUrl}}/api/customers/{{createCustomer.response.body.$.data.id}}